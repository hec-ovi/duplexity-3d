# Copy to .env (git-ignored) and fill in. The backend reads these; the browser never sees them.
#   node --env-file=.env server/index.js

# Fish Audio, for speaking NPC lines. Without a key the game runs and NPCs speak on screen only.
FISH_API_KEY=
# Optional: a cloned voice's reference_id, used for every NPC that has no voice of its own.
FISH_VOICE=
# Optional: s2.1-pro-free (default, free tier), s2.1-pro, s2-pro, s1.
FISH_MODEL=
# Optional: point at a proxy or a self-hosted endpoint. Default https://api.fish.audio
FISH_BASE_URL=

# Backend port. Default 5174.
PORT=
