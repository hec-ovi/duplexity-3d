{
  "$id": "https://doplexity-3d.dev/schema/asset-registry/asset-entry.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetEntry",
  "description": "One usable 3D piece in the catalog. Coordinates/bbox are inlined here (not referenced from persistence) because asset-registry is a leaf that nothing upstream depends on. A `character` entry MUST declare its animations, so npc allowedModes can be validated against what the body can do.",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["room-floor", "wall", "door", "corridor", "prop", "character", "decal"]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "theme": { "type": "string" },
    "size": {
      "type": "array",
      "description": "Axis-aligned bounding box [width, height, depth] in meters.",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "snapPoints": {
      "type": "array",
      "description": "Modular attach points the grid solver connects pieces on.",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "axis": { "type": "string", "enum": ["x", "y", "z"] }
        },
        "required": ["position"],
        "additionalProperties": false
      }
    },
    "glbUrl": { "type": "string" },
    "license": {
      "type": "string",
      "description": "Explicit, commercial-use-clear license (e.g. CC0-1.0). Registration rejects a missing/unclear one."
    },
    "source": { "type": "string", "enum": ["kit", "generated"] },
    "animations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Clip names, required for character entries."
    }
  },
  "required": ["id", "kind", "tags", "theme", "size", "glbUrl", "license", "source"],
  "additionalProperties": false,
  "if": {
    "properties": { "kind": { "const": "character" } },
    "required": ["kind"]
  },
  "then": {
    "required": ["animations"],
    "properties": { "animations": { "minItems": 1 } }
  }
}
